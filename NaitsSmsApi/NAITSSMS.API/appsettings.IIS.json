{
  "DisableHttpsRedirection": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "ValidAudience": "http://localhost:8088",
    "ValidIssuer": "http://localhost:8090",
    "TokenValidityInMinutes": 120
  },
  "Cors": {
    "AllowLanOrigins": true,
    "Origins": [
      "http://localhost:8088",
      "http://127.0.0.1:8088"
    ]
  }
}
